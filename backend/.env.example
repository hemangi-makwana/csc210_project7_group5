# ============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION (SAMPLE / SAFE TEMPLATE)
# ============================================================================
# Copy this file to '.env' in this folder and update with your local credentials.
# NEVER commit real passwords or keys to git.
# ============================================================================

# Backend Server Port
PORT=5000

# Local PostgreSQL Database Credentials
PGHOST=localhost
PGPORT=5432
PGDATABASE=skill_exchange
PGUSER=postgres
PGPASSWORD=your_local_postgres_password

# Alternative Full Connection String (uncomment to use instead of individual fields):
# DATABASE_URL=postgresql://postgres:your_local_postgres_password@localhost:5432/skill_exchange

# JWT Signing Secret — used to sign and verify login tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER commit the real value. This placeholder is safe to commit.
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters

# ============================================================================
# SMTP EMAIL NOTIFICATION SETTINGS (OPTIONAL)
# ============================================================================
# If left blank or unconfigured, in-app notifications continue to work seamlessly
# and email sending is gracefully skipped. Configure these to enable real email alerts.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="Skill Exchange <noreply@skillexchange.local>"

